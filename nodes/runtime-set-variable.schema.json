{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.baudbound.app/nodes/runtime-set-variable.schema.json",
	"title": "BaudBound Node - Variable Operation",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"id",
		"action_type",
		"type",
		"config",
		"runtime_outputs"
	],
	"properties": {
		"id": {
			"type": "string",
			"minLength": 1
		},
		"action_type": {
			"const": "runtime.set_variable"
		},
		"type": {
			"const": "set_variable"
		},
		"config": {
			"$ref": "#/$defs/config"
		},
		"runtime_outputs": {
			"type": "array",
			"items": {
				"$ref": "https://schemas.baudbound.app/program.schema.json#/$defs/runtimeOutput"
			}
		}
	},
	"$defs": {
		"config": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"name",
				"operation",
				"scope"
			],
			"properties": {
				"customName": {
					"type": "string"
				},
				"fieldItemType": {
					"type": "string",
					"enum": [
						"string",
						"number",
						"boolean",
						"object",
						"datetime",
						"duration",
						"file_path"
					]
				},
				"fieldPath": {
					"$ref": "https://schemas.baudbound.app/program.schema.json#/$defs/jsonValue"
				},
				"fieldValueType": {
					"type": "string",
					"enum": [
						"string",
						"number",
						"boolean",
						"object",
						"list",
						"datetime",
						"duration",
						"file_path"
					]
				},
				"itemType": {
					"type": "string",
					"enum": [
						"string",
						"number",
						"boolean",
						"object",
						"datetime",
						"duration",
						"file_path"
					]
				},
				"name": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]+$"
				},
				"operation": {
					"type": "string",
					"enum": [
						"set",
						"increment",
						"toggle_boolean",
						"append_list",
						"remove_list_items",
						"set_object_field",
						"remove_object_field",
						"merge_object",
						"clear",
						"delete"
					]
				},
				"removeMode": {
					"type": "string",
					"enum": [
						"first",
						"all"
					]
				},
				"scope": {
					"type": "string",
					"enum": [
						"runtime",
						"persistent",
						"global"
					]
				},
				"value": {
					"$ref": "https://schemas.baudbound.app/program.schema.json#/$defs/jsonValue"
				},
				"valueType": {
					"type": "string",
					"enum": [
						"string",
						"number",
						"boolean",
						"object",
						"list",
						"datetime",
						"duration",
						"file_path"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"operation": {
								"const": "set"
							}
						},
						"required": [
							"operation"
						]
					},
					"then": {
						"required": [
							"valueType"
						]
					}
				},
				{
					"if": {
						"properties": {
							"operation": {
								"const": "set"
							},
							"valueType": {
								"const": "list"
							}
						},
						"required": [
							"operation",
							"valueType"
						]
					},
					"then": {
						"required": [
							"itemType"
						]
					}
				},
				{
					"if": {
						"properties": {
							"operation": {
								"enum": [
									"set_object_field",
									"remove_object_field"
								]
							}
						}
					},
					"then": {
						"required": [
							"fieldPath"
						]
					}
				},
				{
					"if": {
						"properties": {
							"operation": {
								"const": "set_object_field"
							}
						}
					},
					"then": {
						"required": [
							"fieldValueType"
						]
					}
				},
				{
					"if": {
						"properties": {
							"operation": {
								"const": "set_object_field"
							},
							"fieldValueType": {
								"const": "list"
							}
						},
						"required": [
							"fieldValueType"
						]
					},
					"then": {
						"required": [
							"fieldItemType"
						]
					}
				},
				{
					"if": {
						"properties": {
							"operation": {
								"const": "remove_list_items"
							}
						}
					},
					"then": {
						"required": [
							"removeMode"
						]
					}
				}
			]
		}
	}
}
