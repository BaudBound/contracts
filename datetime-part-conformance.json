{
	"version": 1,
	"description": "Cases for the `.$` parts a datetime or duration exposes, which the runner computes when it refreshes derived metadata and the editor computes for the variable picker and the simulator. A datetime part is read in the offset the value carries, never converted to the machine's own zone. A duration is broken into whole components, so the parts read as a written span rather than the same span counted six ways.",
	"datetime_parts": ["$year", "$month", "$day", "$hour", "$minute", "$second", "$weekday"],
	"duration_parts": ["$days", "$hours", "$minutes", "$seconds", "$milliseconds", "$total_milliseconds"],
	"cases": [
		{
			"value": { "type": "datetime", "value": "2026-07-03T14:30:45+03:00" },
			"parts": { "$year": 2026, "$month": 7, "$day": 3, "$hour": 14, "$minute": 30, "$second": 45, "$weekday": 5 },
			"reason": "each field of a datetime"
		},
		{
			"value": { "type": "datetime", "value": "2026-07-03T14:30:45-05:00" },
			"parts": { "$hour": 14, "$day": 3 },
			"reason": "read in the offset carried, so a machine in another zone agrees"
		},
		{
			"value": { "type": "datetime", "value": "2026-07-03T23:30:00+13:00" },
			"parts": { "$day": 3, "$hour": 23 },
			"reason": "a far offset does not shift the date"
		},
		{
			"value": { "type": "datetime", "value": "2026-01-05T00:00:00Z" },
			"parts": { "$weekday": 1 },
			"reason": "Monday is 1"
		},
		{
			"value": { "type": "datetime", "value": "2026-01-04T00:00:00Z" },
			"parts": { "$weekday": 7 },
			"reason": "Sunday is 7, not 0"
		},
		{
			"value": { "type": "datetime", "value": "2026-01-01T00:00:00Z" },
			"parts": { "$year": 2026, "$month": 1, "$day": 1, "$hour": 0, "$minute": 0, "$second": 0 },
			"reason": "midnight reads as zero, not as missing"
		},

		{
			"value": { "type": "duration", "unit": "milliseconds", "value": 0 },
			"parts": { "$days": 0, "$hours": 0, "$minutes": 0, "$seconds": 0, "$milliseconds": 0, "$total_milliseconds": 0 },
			"reason": "an empty span is zero everywhere"
		},
		{
			"value": { "type": "duration", "unit": "milliseconds", "value": 90061500 },
			"parts": { "$days": 1, "$hours": 1, "$minutes": 1, "$seconds": 1, "$milliseconds": 500, "$total_milliseconds": 90061500 },
			"reason": "one day one hour one minute one and a half seconds, broken into components"
		},
		{
			"value": { "type": "duration", "unit": "seconds", "value": 90 },
			"parts": { "$days": 0, "$hours": 0, "$minutes": 1, "$seconds": 30, "$milliseconds": 0, "$total_milliseconds": 90000 },
			"reason": "a component holds only what is left after the larger one"
		},
		{
			"value": { "type": "duration", "unit": "minutes", "value": 90 },
			"parts": { "$hours": 1, "$minutes": 30, "$total_milliseconds": 5400000 },
			"reason": "the unit is converted before the breakdown"
		},
		{
			"value": { "type": "duration", "unit": "hours", "value": 25 },
			"parts": { "$days": 1, "$hours": 1, "$total_milliseconds": 90000000 },
			"reason": "hours past a day roll into days"
		},
		{
			"value": { "type": "duration", "unit": "days", "value": 2 },
			"parts": { "$days": 2, "$hours": 0, "$total_milliseconds": 172800000 },
			"reason": "a whole day span leaves the smaller components empty"
		},
		{
			"value": { "type": "duration", "unit": "seconds", "value": 1.5 },
			"parts": { "$seconds": 1, "$milliseconds": 500, "$total_milliseconds": 1500 },
			"reason": "a fractional amount resolves to milliseconds"
		}
	]
}
