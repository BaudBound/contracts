{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.baudbound.app/repository.schema.json",
  "title": "BaudBound Script Repository",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "name", "scripts"],
  "properties": {
    "format": {
      "const": "baudbound.repository"
    },
    "format_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/script"
      }
    }
  },
  "$defs": {
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_id",
        "name",
        "summary",
        "target_runtimes",
        "minimum_runner_version",
        "risk_level",
        "tags",
        "permissions",
        "capabilities",
        "latest"
      ],
      "properties": {
        "script_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-8][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$",
          "maxLength": 36
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "author": {
          "type": "string",
          "maxLength": 128
        },
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_runtimes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Linux Headless",
              "Windows Headless",
              "Windows Desktop",
              "Linux Desktop"
            ]
          }
        },
        "minimum_runner_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "maxLength": 64
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "dangerous"]
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "enum": [
              "log",
              "delay",
              "beep",
              "math",
              "calculate",
              "text.transform",
              "url.parse",
              "variable.local.set",
              "variable.persistent.set",
              "variable.global.set",
              "secret.read",
              "runtime.data.read",
              "notification.show",
              "messageBox.show",
              "http.request",
              "file.download",
              "file.read",
              "file.copy",
              "file.move",
              "clipboard.write",
              "application.open",
              "window.query",
              "process.query",
              "serial.write",
              "keyboard.control",
              "mouse.control",
              "screen.pixel.read",
              "sound.play",
              "file.write.limited",
              "process.run",
              "process.shell",
              "file.delete.limited",
              "file.delete.any",
              "file.read.any",
              "file.write.any",
              "clipboard.read",
              "value.convert",
              "trigger.startup",
              "network.webhook",
              "webhook.response",
              "network.websocket",
              "websocket.write",
              "serial.input",
              "window.focus",
              "process.kill",
              "script.run"
            ]
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "enum": [
              "trigger.manual",
              "trigger.schedule",
              "trigger.hotkey",
              "trigger.file_watch",
              "trigger.webhook",
              "trigger.websocket",
              "trigger.serial_input",
              "trigger.startup",
              "trigger.process_started",
              "action.log",
              "action.delay",
              "action.notification",
              "action.message_box",
              "action.http",
              "action.webhook_response",
              "action.websocket",
              "action.file",
              "action.process",
              "action.keyboard",
              "action.mouse",
              "action.clipboard",
              "action.window",
              "action.sound",
              "action.text",
              "action.value",
              "action.calculate",
              "action.pixel",
              "action.serial",
              "action.sub_script",
              "runtime.variables",
              "runtime.color_match",
              "runtime.if",
              "runtime.switch",
              "runtime.repeat",
              "runtime.break_loop",
              "runtime.continue_loop",
              "runtime.while",
              "runtime.for_each",
              "runtime.sub_script",
              "runtime.error_handling",
              "runtime.persistent_storage",
              "runtime.secrets"
            ]
          },
          "uniqueItems": true
        },
        "latest": {
          "$ref": "#/$defs/release"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "package_url", "sha256", "size", "published_at", "release_notes"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "maxLength": 128
        },
        "package_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "release_notes": {
          "type": "string",
          "maxLength": 8000
        }
      }
    }
  }
}
